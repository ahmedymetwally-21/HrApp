# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Self-hosted Ubuntu / LAN REST API endpoint (FastAPI or Node.js + PostgreSQL)
VITE_API_BASE_URL="http://192.168.1.50:8000/api/v1"

# VITE_USE_MOCK_API: Set to "false" when connecting to your self-hosted backend server
VITE_USE_MOCK_API="true"
